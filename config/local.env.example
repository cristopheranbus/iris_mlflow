# Copia estos valores al entorno local; no guardes el archivo resultante en Git.
IRIS_RUNTIME=local
IRIS_LOCAL_DATASET_PATH=data/local/iris_features.csv
IRIS_LOCAL_AUTO_APPROVE=true
IRIS_REGISTERED_MODEL_NAME=iris_classifier
IRIS_DEPLOYMENT_MODEL_NAME=iris_classifier
IRIS_EXPERIMENT_NAME=iris_mlflow_local
IRIS_DATASET_VERSION=iris-local-csv
IRIS_PROJECT_VERSION=2.0.0
IRIS_RANDOM_STATE=42
IRIS_TEST_SIZE=0.20
IRIS_PRIMARY_METRIC=test_f1_weighted
IRIS_SERVING_ENDPOINT_NAME=iris-classifier
IRIS_MIN_TEST_F1_WEIGHTED=0.90
IRIS_MIN_TEST_ACCURACY=0.90
IRIS_MAX_METRIC_REGRESSION=0.01
IRIS_REQUIRED_APPROVAL_TAG=Approval_Check

# Valores exclusivos de Databricks; configúralos sólo en ese runtime.
# IRIS_RUNTIME=databricks
# IRIS_FEATURE_TABLE=workspace.default.iris_features
# IRIS_FEATURE_TABLE_VERSION=
# IRIS_DEPLOYMENT_MODEL_NAME=workspace.default.iris_classifier
# La identidad productiva se configura como variable del bundle/CI, no aquí.
